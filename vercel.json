{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/ops.js": { "includeFiles": "backup/safety-policy.sha256" }
  },
  "rewrites": [
    { "source": "/api/notes/:id", "destination": "/api/notes?id=:id" },
    { "source": "/api/notices/:id", "destination": "/api/notices?id=:id" },
    { "source": "/api/devices/:id", "destination": "/api/devices?id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
